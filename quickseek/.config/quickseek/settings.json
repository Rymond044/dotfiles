{
  "fonts": {
    "icons": "CaskaydiaCove Nerd Font",
    "size": 11
  },
  "launchPrefix": [
    "uwsm",
    "app",
    "--"
  ],
  "include": [
    "~/.cache/glass/quickseek.json"
  ],
  "plugins": [
    {
      "id": "cc",
      "name": "Control center",
      "icon": "󰒓",
      "keywords": "settings",
      "command": [
        "~/.config/binc/cc",
        "quickseek"
      ],
      "refresh": 120
    }
  ],
  "emptyView": [
    "pinned"
  ],
  "files": {
    "enabled": true
  },
  "power": {
    "suspend": [
      "sh",
      "-c",
      "playerctl -a pause; exec systemctl suspend"
    ],
    "screensaver": {
      "title": "Screensaver",
      "icon": "󰔎",
      "keywords": "idle arch logo",
      "order": 5,
      "command": [
        "sh",
        "-c",
        "exec uwsm app -- ~/.config/binc/screensaver"
      ]
    }
  }
}
