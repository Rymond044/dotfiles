#!/usr/bin/env python3
"""Придержать сон, пока hyprlock не дорисуется (юнит sleep-hold.service).

hypridle (inhibit_sleep = 3) отпускает сон на первом кадре блокировки — через ~0,1 с. Fade-in hyprlock (0,5 с)
и надписи (рисуются асинхронно) к этому моменту не готовы: экран засыпал полупрозрачным / без часов.
Здесь своя delay-блокировка logind: на PrepareForSleep ждём, пока hypridle скажет «заблокировано»
(ScreenSaver.GetActive), ещё HOLD секунд — и отпускаем. Верхний предел — InhibitDelayMaxSec logind (2 с).
Без root: delay-блокировку сна активной сессии polkit разрешает пользователю.
"""

import os
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

HOLD = 0.8  # fade-in 0,5 с + запас на надписи
LOCK_WAIT = 1.5  # сессия так и не заблокировалась — не держать дольше

system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
session = Gio.bus_get_sync(Gio.BusType.SESSION)
fd = -1


def take() -> None:
    global fd
    if fd >= 0:
        return
    try:
        res, fds = system.call_with_unix_fd_list_sync(
            "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "Inhibit",
            GLib.Variant("(ssss)", ("sleep", "sleep-hold", "Let hyprlock finish drawing", "delay")),
            GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, -1, None, None,
        )
        fd = fds.get(res.unpack()[0])
    except GLib.Error as e:
        print(f"sleep-hold: не взял блокировку: {e.message}", flush=True)


def release() -> None:
    global fd
    if fd >= 0:
        os.close(fd)
        fd = -1


def locked() -> bool:
    try:
        res = session.call_sync(
            "org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver",
            "GetActive", None, GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 200, None,
        )
        return res.unpack()[0]
    except GLib.Error:
        return False


def wait_and_release(start: float) -> bool:
    if not locked() and time.monotonic() - start < LOCK_WAIT:
        return GLib.SOURCE_CONTINUE  # опрос раз в 50 мс, только во время засыпания
    GLib.timeout_add(int(HOLD * 1000), lambda: release() or GLib.SOURCE_REMOVE)
    return GLib.SOURCE_REMOVE


def on_sleep(_conn, _sender, _path, _iface, _signal, params) -> None:
    if params.unpack()[0]:
        GLib.timeout_add(50, wait_and_release, time.monotonic())
    else:
        take()


system.signal_subscribe(
    "org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep", "/org/freedesktop/login1",
    None, Gio.DBusSignalFlags.NONE, on_sleep,
)
take()
GLib.MainLoop().run()
