#!/usr/bin/env python3
"""Единая блокировка экрана — все точки вызова идут сюда.

hypridle (lock_cmd) ← `loginctl lock-session` ← таймаут, сон/крышка (before_sleep_cmd), powermenu;
автостарт зовёт напрямую. Перед запуском собирает ~/.config/hypr/hyprlock.conf из шаблона wallust
(~/.cache/wallust/hyprlock.conf) под текущие мониторы: блок после «# @PER-MONITOR@» повторяется
для каждого монитора, @MONITOR@ → имя, @N@ → N × scale. Если сборка не удалась — блокирует
со старым конфигом: экран должен заблокироваться в любом случае.

Фон подменяется уменьшенной копией (≤ BG_MAX px, кэш по mtime): он всё равно размыт, а полный
PNG 3840×2160 на каждый монитор делал первый кадр таким тяжёлым, что fade-in успевал пройти
до него, и блокировка появлялась рывком.

Liquid glass (binc/glass on): фон со стеклянной пилюлей ~/.config/binc/lockglass готовит заранее (--prepare),
стеклянные часы рисует `lockglass watch` параллельно запуску hyprlock и раз в минуту. Блокировка ничего
не ждёт: если фон под текущие обои/мониторы ещё не готов — эта блокировка без стекла, а prepare уходит в фон.

«Уже заблокировано?» спрашиваем у hypridle (D-Bus ScreenSaver.GetActive), а не через pidof: pidof ловил
зависший hyprlock и молча не блокировал вообще. Второй hyprlock поверх блокировки запускать нельзя —
он может зависнуть навсегда (см. main).

  lock            — собрать конфиг и заблокировать
  lock --prepare  — только собрать конфиг и фон (после смены обоев, чтобы блокировка не ждала)
"""

import hashlib
import json
import os
import re
import struct
import subprocess
import sys
import time
import zlib

HOME = os.path.expanduser("~")
CACHE = os.environ.get("XDG_CACHE_HOME", f"{HOME}/.cache")
TEMPLATE = f"{CACHE}/wallust/hyprlock.conf"
BG_DIR = f"{CACHE}/hyprlock"
CONFIG = f"{HOME}/.config/hypr/hyprlock.conf"
MARKER = "# @PER-MONITOR@"
BG_MAX = 1920
WALLS_OUTPUTS = f"{CACHE}/walls/outputs.json"  # кадры для портретных мониторов от walls apply
GLASS_OFF = f"{os.environ.get('XDG_STATE_HOME', f'{HOME}/.local/state')}/glass/off"
LOCKGLASS = f"{HOME}/.config/binc/lockglass"
GLASS_JOB = f"{BG_DIR}/glass/job.json"
USED_BG: set[str] = set()


def small_background(path: str) -> str:
    """Уменьшенная копия обоев для hyprlock; при любой ошибке — исходный путь."""
    try:
        st = os.stat(path)
        key = hashlib.sha1(f"{path}:{st.st_mtime_ns}:{st.st_size}:{BG_MAX}".encode()).hexdigest()[:16]
        out = f"{BG_DIR}/bg-{key}.jpg"
        USED_BG.add(out)
        if not os.path.exists(out):
            os.makedirs(BG_DIR, exist_ok=True)
            tmp = f"{out}.tmp.jpg"
            subprocess.run(
                ["magick", path, "-resize", f"{BG_MAX}x{BG_MAX}>", "-quality", "92", tmp],
                check=True, timeout=10, capture_output=True,
            )
            os.replace(tmp, out)
        return out
    except Exception as e:  # noqa: BLE001
        print(f"lock: фон не уменьшен ({e}), беру исходный", file=sys.stderr)
        return path


def walls_outputs() -> dict[str, str]:
    """Кадры, которые walls apply поставил на портретные мониторы: {монитор: путь}. Только если они
    сделаны из текущих обоев: обои могли поставить в обход walls (waypaper) — тогда их нет."""
    with open(WALLS_OUTPUTS) as f:
        outs = json.load(f)
    with open(f"{HOME}/Wallpapers/current", "rb") as f:
        if hashlib.sha1(f.read()).hexdigest() != outs["hash"]:
            return {}
    return {
        name: path for name, path in outs["outputs"].items()
        if path != outs["source"] and os.path.exists(path)
    }


def portrait_backgrounds(head: str) -> str:
    """Свой фон для портретных мониторов — тот же кадр, что поставил на них walls apply.
    Блок идёт после общего (monitor =) и рисуется поверх него."""
    try:
        bg = re.search(r"^background\s*\{.*?^\}", head, flags=re.M | re.S)
        if not bg:
            return ""
        extra = []
        for name, path in walls_outputs().items():
            block = re.sub(r"^(\s*monitor\s*=).*$", rf"\1 {name}", bg.group(0), flags=re.M)
            block = re.sub(r"^(\s*path\s*=).*$", rf"\1 {small_background(path)}", block, flags=re.M)
            extra.append(f"\n# Портретный кадр для {name} (walls)\n{block}\n")
        return "".join(extra)
    except Exception as e:  # noqa: BLE001 — без портретного кадра блокировка всё равно работает
        print(f"lock: портретные фоны пропущены ({e})", file=sys.stderr)
        return ""


def pick_blocks(text: str, glass: bool) -> str:
    """Оставить блоки «# @IF-GLASS@ … # @END@» или «# @IF-NOGLASS@ … # @END@» по режиму."""
    out, keep = [], True
    for line in text.splitlines(keepends=True):
        tag = line.strip()
        if tag in ("# @IF-GLASS@", "# @IF-NOGLASS@"):
            keep = (tag == "# @IF-GLASS@") == glass
        elif tag == "# @END@":
            keep = True
        elif keep:
            out.append(line)
    return "".join(out)


def glass_paths(spec: dict, monitors: list, prepare: bool) -> dict[str, dict]:
    """Файлы стекла от lockglass: {монитор: {bg, clock, clock_size}}. При блокировке — только если всё
    уже собрано (lockglass paths, без numpy), при --prepare — собрать."""
    try:
        portrait = walls_outputs()
    except Exception:  # noqa: BLE001
        portrait = {}
    job = {
        "monitors": [
            {k: m[k] for k in ("name", "width", "height", "scale", "transform")}
            | {"source": portrait.get(m["name"], f"{HOME}/Wallpapers/current")}
            for m in monitors
        ],
        "glass": spec,
    }
    os.makedirs(os.path.dirname(GLASS_JOB), exist_ok=True)
    with open(f"{GLASS_JOB}.tmp", "w") as f:
        json.dump(job, f)
    os.replace(f"{GLASS_JOB}.tmp", GLASS_JOB)
    out = subprocess.run([LOCKGLASS, "prepare" if prepare else "paths"], capture_output=True, text=True, timeout=30)
    if out.returncode == 3:
        raise RuntimeError("фон ещё не собран")
    if out.returncode:
        raise RuntimeError(out.stderr.strip().splitlines()[-1] if out.stderr.strip() else "lockglass упал")
    return json.loads(out.stdout)


def build_config(glass: bool, prepare: bool) -> dict:
    """Собрать конфиг; вернуть файлы стекла ({} — конфиг без стекла)."""
    with open(TEMPLATE) as f:
        text = f.read()
    spec = re.search(r"^# @GLASS@ (.*)$", text, flags=re.M)
    monitors = json.loads(
        subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=2, check=True).stdout
    )
    frames = {}
    if glass and spec:
        try:
            frames = glass_paths(json.loads(spec.group(1)), monitors, prepare)
        except Exception as e:  # noqa: BLE001 — без стекла, но заблокировать
            print(f"lock: стекло не готово ({e}), без него", file=sys.stderr)
            if not prepare:  # к следующей блокировке будет
                subprocess.Popen([sys.argv[0], "--prepare"], stdin=subprocess.DEVNULL, start_new_session=True)
    glass = bool(frames)

    head, sep, block = pick_blocks(text, glass).partition(MARKER)
    if not sep:
        raise ValueError(f"нет маркера {MARKER} в {TEMPLATE}")

    # @WALLPAPER@ — текущие обои (wallust cs подставил бы в {{wallpaper}} путь к файлу схемы)
    head = head.replace("@WALLPAPER@", f"{HOME}/Wallpapers/current")
    head = re.sub(
        r"^(\s*path\s*=\s*)(/\S+)\s*$",
        lambda m: m.group(1) + small_background(m.group(2)),
        head,
        flags=re.M,
    )
    if not glass:
        head += portrait_backgrounds(head)

    parts = [head]
    for m in monitors:
        scale = m["scale"]
        g = frames.get(m["name"], {})
        text = block.replace("@MONITOR@", m["name"]).replace("@FRAME@", g.get("bg", ""))
        text = text.replace("@CLOCK@", g.get("clock", "")).replace("@CLOCKSIZE@", str(g.get("clock_size", 0)))
        text = re.sub(r"@(-?\d+(?:\.\d+)?)@", lambda x: str(round(float(x.group(1)) * scale)), text)
        parts.append(f"# --- {m['name']} (scale {scale}) ---{text}")

    for old in os.listdir(BG_DIR) if os.path.isdir(BG_DIR) else []:
        if f"{BG_DIR}/{old}" not in USED_BG and os.path.isfile(f"{BG_DIR}/{old}"):
            os.remove(f"{BG_DIR}/{old}")

    tmp = f"{CONFIG}.tmp"
    with open(tmp, "w") as f:
        f.write("# Сгенерировано ~/.config/binc/lock из шаблона wallust. Не править руками.\n")
        f.write("".join(parts))
    os.replace(tmp, CONFIG)
    return frames


def blank_png(path: str, size: int) -> None:
    """Прозрачный PNG size×size (без PIL: lock не должен ждать импортов)."""
    def chunk(kind: bytes, data: bytes) -> bytes:
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))

    raw = (b"\0" + b"\0" * 4 * size) * size
    png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))
    with open(f"{path}.tmp", "wb") as f:
        f.write(png)
    os.replace(f"{path}.tmp", path)


def session_locked() -> bool:
    """Сессия уже заблокирована? Спрашиваем hypridle (ScreenSaver.GetActive = его m_isLocked из
    hyprland-lock-notify). Любая ошибка (hypridle ещё не запущен и т. п.) → False: лучше лишний раз
    попытаться заблокировать, чем не заблокировать."""
    try:
        out = subprocess.run(
            ["busctl", "--user", "--timeout=1", "call", "org.freedesktop.ScreenSaver",
             "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver", "GetActive"],
            capture_output=True, text=True, timeout=2,
        ).stdout
        return out.strip() == "b true"
    except Exception:  # noqa: BLE001
        return False


def main() -> None:
    prepare = "--prepare" in sys.argv[1:]
    # Второй hyprlock поверх заблокированной сессии получает от Hyprland `finished` и зовёт exit(1)
    # при живых потоках (auth, Mesa) — и иногда виснет в дедлоке навсегда (~50–70 МБ каждый).
    # Так бывает на каждом сне по таймауту hypridle: 600 с заблокировали, на 1200 с before_sleep_cmd
    # снова шлёт lock-session.
    if not prepare and session_locked():
        print("lock: сессия уже заблокирована, второй hyprlock не нужен", file=sys.stderr)
        return
    glass = {}
    try:
        glass = build_config(not os.path.exists(GLASS_OFF), prepare)
    except Exception as e:  # noqa: BLE001 — блокировка важнее красивой вёрстки
        print(f"lock: не удалось собрать конфиг ({e}), блокирую со старым", file=sys.stderr)
        if prepare:
            sys.exit(1)
    if prepare:
        return
    if glass:
        # Часы прошлой блокировки показали бы старое время → прозрачная заглушка, пока watch рисует новые.
        # Удалять нельзя: картинку, которой не было при старте, hyprlock 0.9.6 потом так и не подгружает
        now = time.localtime()
        for g in glass.values():
            try:
                if time.localtime(os.stat(g["clock"]).st_mtime)[:5] == now[:5]:
                    continue
            except OSError:
                pass
            blank_png(g["clock"], g["clock_size"])
        # exec ниже сохраняет PID — watch ждёт выхода самого hyprlock
        subprocess.Popen(
            [LOCKGLASS, "watch", str(os.getpid())],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, start_new_session=True,
        )
    os.execvp("hyprlock", ["hyprlock", *sys.argv[1:]])


if __name__ == "__main__":
    main()
