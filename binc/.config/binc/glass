#!/usr/bin/env bash
# Liquid glass одним переключателем: плагин hyprglass + полупрозрачные waybar, swaync, rofi и quickseek.
#   glass          — переключить
#   glass on|off   — включить / вернуть исходный вид (как до стекла)
#   glass status   — on | off
#   glass sync     — только записать ~/.cache/glass/* по состоянию (автостарт, waybar/launch.sh)
# Состояние: ~/.local/state/glass/off (есть файл — выключено). Его же читает hypr/lua/glass.lua
# при каждой загрузке конфига. Стеклянные стили — в */glass.{css,rasi} рядом с основными,
# основные стили подключают ~/.cache/glass/*: при «off» там пусто.
set -euo pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/glass
cache=${XDG_CACHE_HOME:-$HOME/.cache}/glass
off_file=$state_dir/off

is_on() { [[ ! -e $off_file ]]; }

# Запись через временный файл: waybar/swaync/rofi могут читать в этот момент
put() {
	printf '%s\n' "$2" >"$cache/$1.tmp"
	mv -f "$cache/$1.tmp" "$cache/$1"
}

sync_files() {
	mkdir -p "$cache"
	if is_on; then
		put waybar.css "@import \"$HOME/.config/waybar/glass.css\";"
		put swaync.css "@import \"$HOME/.config/swaync/glass.css\";"
		put rofi.rasi "@import \"$HOME/.config/rofi/glass.rasi\""
		put quickseek.json '{ "opacity": 0.45 }' # подключён через include в quickseek/settings.json
	else
		local f
		for f in waybar.css swaync.css rofi.rasi; do put "$f" "/* glass off */"; done
		put quickseek.json '{}'
	fi
}

apply() {
	sync_files
	hyprctl reload >/dev/null # glass.lua включает/выключает плагин по состоянию
	pkill -USR2 -x waybar || true # перечитать стиль
	swaync-client -rs >/dev/null 2>&1 || true
	# rofi подхватит при следующем запуске
	notify-send -t 1500 -h string:x-canonical-private-synchronous:glass "Liquid glass" \
		"$(is_on && echo On || echo Off)"
}

case ${1:-toggle} in
on) rm -f "$off_file" && apply ;;
off) mkdir -p "$state_dir" && : >"$off_file" && apply ;;
toggle) if is_on; then "$0" off; else "$0" on; fi ;;
status) is_on && echo on || echo off ;;
sync) sync_files ;;
*)
	echo "usage: glass [on|off|toggle|status|sync]" >&2
	exit 2
	;;
esac
