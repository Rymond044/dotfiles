#!/usr/bin/env bash
# Поставить обои и перекрасить всё. Логика переехала в walls apply (обрезка под портретные
# мониторы, отмена предыдущего незаконченного применения, история для выбиралки).
if [ -z "$1" ]; then
  echo "Usage: wallust-swww /path/to/wallpaper" >&2
  exit 1
fi
exec ~/.config/binc/walls apply "$@"
