{% set light = ((background|red|int) + (background|green|int) + (background|blue|int)) > 384 -%}
/* ~/.config/wallust/swaync.css.j2 */

/* Базовые цвета для стекла (swaync/glass.css) */
@define-color glass-bg {{background}};
@define-color glass-bg-alt {{color0}};

@define-color cc-bg rgba({{background | rgb}}, 0.9);
@define-color noti-bg rgba({{color0 | rgb}}, 0.9);

@define-color noti-border-color {{color8}};
@define-color noti-bg-darker rgba({{background | rgb}}, 0.9);
{% if light -%}
@define-color noti-bg-hover rgba({{background | darken(0.1) | rgb}}, 0.9);
{%- else -%}
@define-color noti-bg-hover rgba({{color8 | rgb}}, 0.8);
{%- endif %}
@define-color text-color {{foreground}};
@define-color text-color-disabled {% if light %}{{color8}}{% else %}{{color7}}{% endif %};
@define-color bg-selected {{color1}};
@define-color border-green {{color2}};
@define-color red-base {{color1}};
@define-color red-hover {{color9}};
@define-color green-base {{color2}};
@define-color blue-base {{color4}};

/* Встроенный стиль swaync 0.12 (/etc/xdg/swaync/style.css) красит подписи через CSS-переменные,
   а не @define-color: --text-color там белый → в светлой теме, например, «Do Not Disturb» не видно. */
:root {
    --text-color: {{foreground}};
    --text-color-disabled: {% if light %}{{color8}}{% else %}{{color7}}{% endif %};
{%- if light %}
    --noti-bg-focus: rgba({{foreground | rgb}}, 0.08);  /* фокус группы: по умолчанию тёмно-серый 0.6 */
{%- endif %}
}
