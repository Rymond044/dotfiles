# Цвета ghostty из wallust (подключается из config.ghostty через config-file)
background = {{background}}
foreground = {{foreground}}
cursor-color = {{color1}}
selection-background = {{foreground}}
selection-foreground = {{background}}
# В светлой теме та же раскладка, что у pywal: color0 — светлая поверхность, color7/15 — тёмный
# текст (btop TTY, neopywal и пр. пишут основной текст «белым»), все цвета текста — контраст ≥ 4.5.
palette = 0={{color0}}
palette = 7={{color7}}
palette = 8={{color8}}
palette = 15={{color15}}
palette = 1={{color1}}
palette = 2={{color2}}
palette = 3={{color3}}
palette = 4={{color4}}
palette = 5={{color5}}
palette = 6={{color6}}
palette = 9={{color9}}
palette = 10={{color10}}
palette = 11={{color11}}
palette = 12={{color12}}
palette = 13={{color13}}
palette = 14={{color14}}
