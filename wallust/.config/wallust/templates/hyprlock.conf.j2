# Шаблон hyprlock. wallust → ~/.cache/wallust/hyprlock.conf, а ~/.config/binc/lock при каждой
# блокировке собирает из него ~/.config/hypr/hyprlock.conf под текущие мониторы:
# блок после маркера @PER-MONITOR@ повторяется для каждого монитора, @MONITOR@ → имя монитора,
# @N@ → N × scale монитора (hyprlock считает в физических пикселях, а размеры здесь логические —
# так виджеты одинаковые на eDP ×2, HDMI ×1.25 и вертикальном DP-1 ×1).

# GENERAL & ANIMATIONS (общие настройки)
general {
    hide_cursor = false
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
}

auth {
    fingerprint {
        enabled = true
        retry_delay = 500
        ready_message = Touch ID or Password
        present_message = Scanning...
    }
}

# Фон — на все мониторы
background {
    monitor =
    path = {{wallpaper}}
    blur_passes = 2
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# @PER-MONITOR@

label {
    monitor = @MONITOR@
    text = cmd[update:1000] echo "$(date +"%-I:%M%p")"
    color = rgba({{foreground | rgb}}, 0.75)
    font_size = @70@
    font_family = SF Pro Display Bold
    # от центра, как и дата: при привязке к верху на высоком DP-1 часы уезжали от даты
    position = 0, @300@
    halign = center
    valign = center
}

label {
    monitor = @MONITOR@
    text = $LAYOUT
    color = rgba({{foreground | rgb}}, 0.65)
    font_size = @12.5@
    font_family = system-ui
    position = 0, @-210@
    halign = center
    valign = center
}

label {
    monitor = @MONITOR@
    text = cmd[update:1000] echo "<span>$(date '+%A, %d %B')</span>"
    color = rgba({{foreground | rgb}}, 0.65)
    font_size = @17.5@
    font_family = system-ui
    position = 0, @200@
    halign = center
    valign = center
}

image {
    monitor = @MONITOR@
    path = ~/Pictures/pfp/current_pfp.jpg
    size = @125@
    rounding = -1
    border_size = @2@
    border_color = rgba({{color2 | rgb}}, 1)
    position = 0, @-50@
    halign = center
    valign = center
}

label {
    monitor = @MONITOR@
    text = Hello, $USER
    color = rgba({{foreground | rgb}}, 0.65)
    font_size = @17.5@
    font_family = system-ui
    position = 0, @-130@
    halign = center
    valign = center
}

input-field {
    monitor = @MONITOR@
    size = @160@, @35@
    outline_thickness = @1@
    dots_size = 0.2
    dots_spacing = 0.2
    dots_center = true
    outer_color = rgba({{color0 | rgb}}, 0)
    inner_color = rgba({{color0 | rgb}}, 0.35)
    font_color = rgba({{foreground | rgb}}, 1)
    fade_on_empty = false
    font_family = system-ui
    placeholder_text = <i><span foreground="##{{foreground | strip}}99">Touch ID or Password</span></i>
    hide_input = false
    position = 0, @-170@
    halign = center
    valign = center
}
