{
  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "i use arch btw 󰣇",
    "on-click": "hyprctl dispatch 'hl.plugin.hymission.toggle'",
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "all-outputs": false,
    "sort-by-number": true,
    "active-only": true,
    "format-icons": {
      // smw: у каждого монитора свои 9 ws (1–9, 10–18, 19–27, …) — подпись по номеру внутри монитора
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "一",
      "11": "二",
      "12": "三",
      "13": "四",
      "14": "五",
      "15": "六",
      "16": "七",
      "17": "八",
      "18": "九",
      "19": "一",
      "20": "二",
      "21": "三",
      "22": "四",
      "23": "五",
      "24": "六",
      "25": "七",
      "26": "八",
      "27": "九",
      "28": "一",
      "29": "二",
      "30": "三",
      "31": "四",
      "32": "五",
      "33": "六",
      "34": "七",
      "35": "八",
      "36": "九",
      "active": "󱓻",
      "default": "",
    },
  },
  "tray": {
    "format": "{icon}",
    "icon-size": 18,
    "spacing": 10,
    "show-passive-items": true,
    "tooltip": false,
  },
  // Кнопки видны, только пока есть плеер (playing/paused); статус через playerctl -F, без поллинга.
  "custom/playerctl-prev": {
    "exec": "~/.config/waybar/scripts/player-button.sh prev",
    "return-type": "json",
    "on-click": "playerctl previous",
    "tooltip": false,
  },
  "custom/playerctl": {
    "format": "<span font='20px'>{icon}</span> <span rise='2000'>{text}</span>",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/player.sh",
    "hide-empty-text": true, // иначе при пустом тексте остаётся пустая «таблетка» (формат не пустой)
    "max-length": 80,
    "format-icons": {
      "Playing": "󰐊",
      "Paused": "󰏤",
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl volume 0.05+",
    "on-scroll-down": "playerctl volume 0.05-",
  },
  "custom/playerctl-next": {
    "exec": "~/.config/waybar/scripts/player-button.sh next",
    "return-type": "json",
    "on-click": "playerctl next",
    "tooltip": false,
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "swaync-client -C",
    "escape": true,
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "max-volume": 150,
    "scroll-step": 5,
    "format-muted": " ",
    "format-icons": {
      "headphone": "",
      "default": [
        "",
        "",
        ""
      ],
    },
    "on-click": "kitty --class wiremix -e wiremix",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃜",
      "󰃛",
      "󰃚"
    ],
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "tooltip": false,
  },
  "bluetooth": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "{status}",
    "on-click": "kitty --class bluetui -e bluetui",
  },
  "network": {
    "interface": "wlan0",
    "format-wifi": "  {essid}",
    "tooltip": true,
    "tooltip-format": "SSID: {essid}\nSignal: {signalStrength}%\nSpeed: {bandwidthDownBits} ↓ / {bandwidthUpBits} ↑",
    "format-ethernet": "",
    "format-disconnected": "",
    "interval": 10,
    "on-click": "kitty --class impala -e sudo impala",
  },
  "custom/sysmon": {
    "format": "󰍛",
    "tooltip": false,
    "on-click": "kitty --class btop -e btop",
  },
  "cpu": {
    "format": "",
    "tooltip": false,
  },
  "memory": {
    "format": "",
    "tooltip": false,
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "on-click": "~/.config/waybar/scripts/power-profiles.sh",
  },
  "clock": {
    "format": "{:%H:%M  }",
    "format-alt": "{:%e %B  }",
    "tooltip": true,
    "tooltip-format": "{calendar}",
    "calendar": {
      "format": {
        "months": "<span size='larger' style='italic'>{}</span>",
        "today": "<b><big>{}</big></b>",
      },
    },
    "on-click-right": "kitty --class calcure -e calcure",
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu/type-1/powermenu.sh",
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "en",
    "format-ru": "ru",
  },
}
