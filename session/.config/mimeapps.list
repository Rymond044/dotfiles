# Приложения по умолчанию (xdg-open, Nautilus, порталы). Подбор — по установленным .desktop.
# Тип файла: `xdg-mime query filetype ФАЙЛ`, кто откроет: `xdg-mime query default ТИП`.

[Default Applications]
# Папки
inode/directory=org.gnome.Nautilus.desktop

# Веб: ссылки и HTML
