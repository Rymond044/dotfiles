[Desktop Entry]
# Перекрывает /usr/share/applications/nvim.desktop: nvim в kitty через zsh (см. ~/.config/binc/edit),
# а не в случайном терминале по Terminal=true.
Name=Neovim
GenericName=Text Editor
Comment=Edit text files
TryExec=nvim
Exec=sh -c "exec \\"\\$HOME/.config/binc/edit\\" \\"\\$@\\"" edit %F
Terminal=false
Type=Application
Keywords=Text;editor;
Icon=nvim
Categories=Utility;TextEditor;Development;
StartupNotify=false
StartupWMClass=kitty
MimeType=text/english;text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;text/markdown;application/json;application/yaml;application/toml;text/x-python3;text/x-lua;text/javascript;application/xml;
